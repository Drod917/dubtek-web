---
import { lavaEdgeColors, SITE_LAVA } from "@/styles/palettes";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  themeColor?: string;
  /** html/body backdrop, for when the page's bottom edge differs from the status-bar color. */
  backgroundColor?: string;
}

// Every page sits on the lava, so the browser chrome matches its edges by default: near-black up top for the
// status bar, charcoal at the floor for the html/body backdrop behind Safari's bottom toolbar.
const lavaEdges = lavaEdgeColors(SITE_LAVA.palette, SITE_LAVA.lift);

const {
  title = "Dubtek - Software Development",
  description = "Dubtek is a product, design, and software development studio. Obsessed with the details, we design and build what's next, from first idea to launch.",
  image = "/images/og-cover.png",
  noindex = false,
  themeColor = lavaEdges.top,
  backgroundColor = lavaEdges.bottom,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Dubtek",
  description: "Product, design, and software development studio obsessed with the details.",
  url: Astro.site?.toString(),
  image: ogImageURL.toString(),
  areaServed: "Worldwide",
  sameAs: ["https://www.linkedin.com/company/dubtek", "https://github.com/dubtek-web"],
};
---

<!doctype html>
<html lang="en" style={`background-color: ${backgroundColor}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Dubtek" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=JetBrains+Mono:wght@500&family=Silkscreen&family=VT323&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style={`background-color: ${backgroundColor}`}>
    <slot />
  </body>
</html>
