---
import dubtekLogo from "@/assets/images/dubtek-screenprint-shine-logo.png";
import LavaBackground from "@components/LavaBackground.astro";
import { Image } from "astro:assets";
---

<main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#050220]">
  <LavaBackground palette="Ultraviolet" />

  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(60% 50% at 50% 50%, rgba(5,2,32,0.72), rgba(5,2,32,0.32) 60%, transparent 80%)"
  >
  </div>

  <div class="wrap relative py-24 text-center">
    <span class="eyebrow mt-8 justify-center text-white/70 [text-shadow:0_2px_16px_rgba(5,2,32,0.8)]"
      >Under construction. Check back soon!</span
    >
    <Image
      src={dubtekLogo}
      alt="Dubtek"
      class="mx-auto mt-4 h-auto w-full max-w-md sm:max-w-lg md:max-w-xl drop-shadow-[0_4px_28px_rgba(5,2,32,0.85)]"
    />

    <p class="mx-auto mt-4 max-w-md text-lg text-white/70 [text-shadow:0_2px_16px_rgba(5,2,32,0.8)]">
      We build thoughtful digital experiences designed around the people using them. Blending technology, creativity, and
      intuitive design with a research-backed approach—and an obsession with the details.
      <!-- or reach out if you'd like to talk in the meantime. -->
    </p>

    <!-- <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href="mailto:hello@dubtek.io" class="btn-primary">Get in touch</a>
    </div> -->
  </div>
</main>
