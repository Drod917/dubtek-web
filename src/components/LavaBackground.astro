---
import type { PaletteName } from "@/styles/palettes";

interface Props {
  palette?: PaletteName;
  blobCount?: number;
  speed?: number;
  /** How far the floor of the frame lifts from black toward a soft charcoal (0–0.8). */
  lift?: number;
  /** Strength of the gloss sheen and the glitter suspended in the wax (0–2). */
  shine?: number;
  /** Seconds into the simulation to open on — picks the composition of the first (and reduced-motion) frame. */
  start?: number;
}

const {
  palette = "Ultraviolet",
  blobCount = 9,
  speed = 0.55,
  lift = 0.22,
  shine = 0.8,
  start = 0,
} = Astro.props;
---

<canvas
  id="lava-bg"
  class="pointer-events-none fixed inset-0 h-full w-full"
  data-palette={palette}
  data-blob-count={blobCount}
  data-speed={speed}
  data-lift={lift}
  data-shine={shine}
  data-start={start}></canvas>

<script>
  import { PALETTES, type PaletteName } from "@/styles/palettes";

  const VERT = `#version 300 es
in vec2 a;
void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;

  /*
   * Metaball lava. Notes live here rather than in the GLSL source, since string contents ship verbatim:
   * - each drop gets a slow, seeded anisotropic stretch and low-order wobble so it reads as deforming wax;
   *   its gradient is pulled back into screen space through the transpose of that warp
   * - drops merge through a soft p-norm union so the necks between them fill out as rounded fillets
   * - color follows depth below the merged surface (~T at the edge, ~1 at a core): the shaded underside
   *   gets a wide band of the pale ramp stops, the lit top only a hairline
   * - a near-white bloom hugs the whole perimeter, with a pale haze inside the crown
   */
  const FRAG = `#version 300 es
precision highp float;
out vec4 fragColor;
uniform vec2 uRes;
uniform vec3 uBalls[16];
uniform int uCount;
uniform float uRim;
uniform vec3 uStops[6];
uniform vec3 uBg[2];
uniform vec2 uLdir[16];
uniform float uGlowSize;
uniform float uGlowInt;
uniform float uSoft;
uniform float uShine;
uniform float uTime;
uniform float uLift;
uniform float uSpread;
uniform float uVign;
uniform float uTwF;

float h21(vec2 x){ return fract(sin(dot(x, vec2(41.3, 289.1))) * 43758.5453); }

vec3 ramp(float s){
  const float p0=0.0, p1=0.03, p2=0.16, p3=0.36, p4=0.62, p5=1.0;
  vec3 c = uStops[0];
  c = mix(c, uStops[1], smoothstep(p0, p1, s));
  c = mix(c, uStops[2], smoothstep(p1, p2, s));
  c = mix(c, uStops[3], smoothstep(p2, p3, s));
  c = mix(c, uStops[4], smoothstep(p3, p4, s));
  c = mix(c, uStops[5], smoothstep(p4, p5, s));
  return c;
}

void main(){
  vec2 p = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
  float f = 0.0;
  float wsum = 0.0;
  float rw = 0.0;
  float spill = 0.0;
  vec2 g = vec2(0.0);
  float litB = 0.0;
  vec2 ldir = vec2(0.0);
  for (int i = 0; i < 16; i++){
    if (i >= uCount) break;
    vec2 d = p - uBalls[i].xy;
    float R2 = 4.0 * uBalls[i].z * uBalls[i].z;
    float sd1 = h21(vec2(float(i) * 1.37, 7.1));
    float sd2 = h21(vec2(float(i) * 2.11, 3.3));
    float ph = sd1 * 6.283 + uTime * (0.06 + 0.05 * sd2);
    float ax = sd1 * 6.283 + 0.35 * sin(ph * 0.7);
    float el = 0.02 + 0.032 * sd2 + 0.018 * sin(ph);
    vec2 dr = vec2(d.x * cos(ax) + d.y * sin(ax), -d.x * sin(ax) + d.y * cos(ax));
    dr = vec2(dr.x * (1.0 + el), dr.y / (1.0 + el));
    float th = atan(dr.y, dr.x);
    R2 *= 1.0 + 0.032 * sin(3.0 * th + ph * 1.3) + 0.022 * sin(2.0 * th - ph);
    d = dr;
    float dd = dot(d, d);
    float q = max(0.0, 1.0 - dd / R2);
    float w3 = q * q * q * q;
    float w2 = w3 * pow(w3, 0.08);
    f += w2;
    ldir += w2 * uLdir[i];
    wsum += w2;
    rw += w2 * uBalls[i].z;
    vec2 gw = -8.0 * q * q * q * d / R2;
    gw = vec2(gw.x * (1.0 + el), gw.y / (1.0 + el));
    vec2 gws = vec2(gw.x * cos(ax) - gw.y * sin(ax), gw.x * sin(ax) + gw.y * cos(ax));
    g += w2 * gws;
    float gli = length(gws);
    litB += w2 * (gli > 1e-6 ? -gws.y / gli : 0.0);
    float cq = max(0.0, 1.0 - dd / (R2 * uGlowSize));
    spill = max(spill, cq * cq * cq);
  }

  f = pow(f, 0.926);
  g /= max(f, 1e-4);

  const float T = 0.36;
  float vign = clamp(length(p * vec2(0.62, 1.0)) * 0.9 * uVign, 0.0, 1.0);
  float lift = smoothstep(mix(-0.15, 1.30, uSpread), -0.55, p.y);
  vec3 col = mix(uBg[0], uBg[1], vign) + mix(uBg[0], vec3(1.0), 0.25) * lift * uLift;
  col += ramp(0.30) * min(spill, 1.0) * 0.085 * uGlowInt;
  col += ramp(0.12) * smoothstep(0.06, T, f) * 0.20 * uRim;

  float s = clamp((f - T) / (0.95 - T), 0.0, 1.0);
  float rAvg = rw / max(wsum, 1e-5);
  float litScale = mix(0.18, 1.0, smoothstep(0.035, 0.14, rAvg));
  vec2 Lv = length(ldir) > 1e-4 ? normalize(ldir) : vec2(-0.6, -0.8);
  float jit = 0.78 + 0.30 * (Lv.x * 0.5 + 0.5);
  float lit = litB / max(wsum, 1e-6);
  float undf = smoothstep(0.62, -0.95, lit) * (1.0 - smoothstep(0.55, 0.99, s));
  undf *= mix(0.45, 1.0, litScale) * jit;
  float band = mix(0.045, 0.82, undf);
  float sd = 0.62 * smoothstep(0.0, band, s);
  vec3 inner = ramp(clamp(sd, 0.0, 0.62)) + 0.022;

  vec3 n = normalize(vec3(g * 0.5, 1.0));
  vec3 L = normalize(vec3(0.0, -0.72, 0.70));
  float und = smoothstep(0.30, -0.95, lit);
  inner += ramp(0.02) * exp(-abs(f - T) * mix(64.0, 42.0, und)) * mix(0.10, 0.58, und) * uRim * litScale;
  float edg = exp(-abs(f - T) * 46.0);
  inner += vec3(1.0, 0.96, 0.99) * edg * mix(0.62, 0.70, und) * uRim * litScale;
  float crown = (1.0 - smoothstep(0.0, 0.38, s)) * smoothstep(-0.95, 0.30, lit);
  inner += vec3(0.93, 0.90, 1.0) * crown * 0.85 * uRim * litScale;

  inner += vec3(1.0, 0.97, 0.94) * pow(max(dot(n, L), 0.0), 6.0) * 0.10 * uShine;
  vec2 id = floor(p * 78.0);
  vec2 fr = fract(p * 78.0);
  float r1 = h21(id), r2 = h21(id + 7.7);
  float tw = 0.45 + 0.55 * sin(uTime * uTwF + r1 * 24.0);
  float spark = smoothstep(0.20, 0.0, length(fr - vec2(r1, r2))) * step(0.80, h21(id + 3.3)) * max(tw, 0.0);
  inner += vec3(1.0, 0.98, 0.95) * spark * smoothstep(0.02, 0.35, s) * 0.85 * uShine;

  float w = max(fwidth(f), uSoft);
  float a = clamp((f - T) / max(w, 1e-5) + 0.5, 0.0, 1.0);
  col = mix(col, inner, a);

  float grain = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
  col += (grain - 0.5) * 0.012;
  fragColor = vec4(col, 1.0);
}`;

  function hex(h: string): [number, number, number] {
    return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];
  }

  function initLava(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext("webgl2", { antialias: false });
    if (!gl) return;

    const paletteName = (canvas.dataset.palette || "Ember") as PaletteName;
    const blobCount = Math.max(3, Math.min(12, parseInt(canvas.dataset.blobCount || "9", 10)));
    const speed = parseFloat(canvas.dataset.speed || "0.55");
    const lift = parseFloat(canvas.dataset.lift || "0.22");
    const shine = parseFloat(canvas.dataset.shine || "0.8");
    const start = parseFloat(canvas.dataset.start || "0");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const mk = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, mk(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, mk(gl.FRAGMENT_SHADER, FRAG));
    gl.bindAttribLocation(prog, 0, "a");
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    const u = {
      res: gl.getUniformLocation(prog, "uRes"),
      balls: gl.getUniformLocation(prog, "uBalls"),
      count: gl.getUniformLocation(prog, "uCount"),
      rim: gl.getUniformLocation(prog, "uRim"),
      stops: gl.getUniformLocation(prog, "uStops"),
      bg: gl.getUniformLocation(prog, "uBg"),
      ldir: gl.getUniformLocation(prog, "uLdir"),
      glowSize: gl.getUniformLocation(prog, "uGlowSize"),
      glowInt: gl.getUniformLocation(prog, "uGlowInt"),
      soft: gl.getUniformLocation(prog, "uSoft"),
      shine: gl.getUniformLocation(prog, "uShine"),
      time: gl.getUniformLocation(prog, "uTime"),
      lift: gl.getUniformLocation(prog, "uLift"),
      spread: gl.getUniformLocation(prog, "uSpread"),
      vign: gl.getUniformLocation(prog, "uVign"),
      twf: gl.getUniformLocation(prog, "uTwF"),
    };

    const pal = PALETTES[paletteName] || PALETTES.Ember;
    gl.uniform3fv(u.stops, new Float32Array(pal.stops.flatMap(hex)));
    gl.uniform3fv(u.bg, new Float32Array(pal.bg.flatMap(hex)));

    let s = 20260814;
    const rnd = () => (s = (s * 1664525 + 1013904223) % 4294967296) / 4294967296;
    const balls = Array.from({ length: blobCount }, (_, i) => ({
      x: (-0.5 + (i + 0.5) / blobCount + ((rnd() - 0.5) * 0.25) / blobCount) * 2.05,
      period: 38 + rnd() * 30,
      phase: (i + 0.5) / blobCount + ((rnd() - 0.5) * 0.5) / blobCount,
      sway: 0.015 + rnd() * 0.025,
      px: rnd() * 6.28,
      py: rnd() * 6.28,
      sx: 0.08 + rnd() * 0.14,
      lightAngle: -Math.PI / 2 + (rnd() - 0.5) * 0.18,
      lightDrift: 0,
      r: (i % 4 === 0 ? 0.215 : i % 3 === 0 ? 0.145 : 0.1) + rnd() * 0.04,
    }));

    const data = new Float32Array(48);
    const ldir = new Float32Array(32);

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(canvas.clientWidth * dpr);
      const h = Math.round(canvas.clientHeight * dpr);
      if (!w || !h) return;
      // Assigning canvas.width/height clears the drawing buffer, so only touch it on a real change.
      if (w === canvas.width && h === canvas.height) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      if (reduceMotion) draw(start); // the static path has no loop to redraw the cleared buffer
    }
    window.addEventListener("resize", resize);
    window.visualViewport?.addEventListener("resize", resize);
    resize();
    requestAnimationFrame(() => requestAnimationFrame(resize));

    function draw(t: number) {
      const asp = canvas.width / Math.max(canvas.height, 1);
      const wide = Math.max(asp, 1) * 0.62;
      const yB = -0.46,
        yT = 0.42;
      balls.forEach((b, i) => {
        const p = ((t * speed) / b.period + b.phase) % 1;
        let y,
          lat = 0;
        if (p < 0.46) {
          y = yB + (yT - yB) * (p / 0.46);
        } else if (p < 0.54) {
          y = yT + Math.sin((p - 0.46) * 39) * 0.008;
        } else {
          const uu = (p - 0.54) / 0.46;
          y = yT - (yT - yB) * (1 - Math.pow(1 - uu, 1.35));
          lat = (i % 2 ? 1 : -1) * 0.045 * Math.sin(Math.PI * uu);
        }
        const r = b.r * (1 + Math.sin(t * 0.18 * speed + b.py) * 0.04);
        const x = (b.x + lat + Math.sin(t * b.sx * speed * 0.3 + b.px) * b.sway) * wide;
        data[i * 3] = x;
        data[i * 3 + 1] = y;
        data[i * 3 + 2] = r;
        const a = b.lightAngle + t * b.lightDrift * speed;
        ldir[i * 2] = Math.cos(a);
        ldir[i * 2 + 1] = Math.sin(a);
      });
      gl.uniform2f(u.res, canvas.width, canvas.height);
      gl.uniform3fv(u.balls, data);
      gl.uniform2fv(u.ldir, ldir);
      gl.uniform1i(u.count, balls.length);
      gl.uniform1f(u.rim, 1);
      gl.uniform1f(u.glowSize, 6);
      gl.uniform1f(u.glowInt, 1);
      gl.uniform1f(u.soft, 0.02);
      gl.uniform1f(u.shine, shine);
      gl.uniform1f(u.time, t);
      gl.uniform1f(u.lift, lift);
      gl.uniform1f(u.spread, 0.5);
      gl.uniform1f(u.vign, 1);
      gl.uniform1f(u.twf, 1.8);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    let raf = 0;
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        window.removeEventListener("resize", resize);
        window.visualViewport?.removeEventListener("resize", resize);
      },
      { once: true },
    );

    if (reduceMotion) {
      draw(start);
      return;
    }

    const t0 = performance.now();
    const loop = () => {
      draw(start + (performance.now() - t0) / 1000);
      raf = requestAnimationFrame(loop);
    };
    loop();
  }

  const canvas = document.getElementById("lava-bg") as HTMLCanvasElement | null;
  if (canvas) initLava(canvas);
</script>
