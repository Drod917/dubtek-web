---
interface Props {
  palette?: "Ember" | "Magenta" | "Ultraviolet" | "Iridescent" | "Medal";
  blobCount?: number;
  speed?: number;
}

const { palette = "Ultraviolet", blobCount = 9, speed = 0.55 } = Astro.props;
---

<canvas
  id="lava-bg"
  class="pointer-events-none fixed inset-0 h-full w-full"
  data-palette={palette}
  data-blob-count={blobCount}
  data-speed={speed}
></canvas>

<script>
  const PALETTES: Record<string, { stops: string[]; bg: string[] }> = {
    Ember: { stops: ["ffe9a3", "ffb020", "ff3a2e", "d0186a", "4a2fd0", "0b1550"], bg: ["05081c", "010207"] },
    Magenta: { stops: ["ffe2ec", "ff5fa8", "ff1f5e", "c01050", "6a0a3a", "2a0518"], bg: ["1d0310", "080105"] },
    Ultraviolet: { stops: ["ffd0a0", "ff6a4a", "ff2f4f", "b02ad0", "5a2ee0", "2a1ab0"], bg: ["160c58", "050220"] },
    Iridescent: { stops: ["eafcff", "58efff", "9a5cff", "ff3fa2", "ff6a2a", "07070c"], bg: ["0b0a14", "000000"] },
    Medal: { stops: ["f7e2ff", "ffb3f0", "7ee8ff", "3aa8ff", "5b3fd6", "07060f"], bg: ["0a0912", "000000"] },
  };

  const VERT = `#version 300 es
in vec2 a;
void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;

  const FRAG = `#version 300 es
precision highp float;
out vec4 fragColor;
uniform vec2 uRes;
uniform vec3 uBalls[16];
uniform int uCount;
uniform float uRim;
uniform vec3 uStops[6];
uniform vec3 uBg[2];
uniform vec2 uLdir[16];
uniform float uGlowSize;
uniform float uGlowInt;
uniform float uSoft;
uniform float uShine;
uniform float uTime;
uniform float uLift;
uniform float uSpread;
uniform float uVign;
uniform float uTwF;

float h21(vec2 x){ return fract(sin(dot(x, vec2(41.3, 289.1))) * 43758.5453); }

vec3 ramp(float s){
  const float p0=0.0, p1=0.045, p2=0.20, p3=0.44, p4=0.70, p5=1.0;
  vec3 c = uStops[0];
  c = mix(c, uStops[1], smoothstep(p0, p1, s));
  c = mix(c, uStops[2], smoothstep(p1, p2, s));
  c = mix(c, uStops[3], smoothstep(p2, p3, s));
  c = mix(c, uStops[4], smoothstep(p3, p4, s));
  c = mix(c, uStops[5], smoothstep(p4, p5, s));
  return c;
}

void main(){
  vec2 p = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
  float f = 0.0;
  float spill = 0.0;
  vec2 g = vec2(0.0);
  vec2 ldir = vec2(0.0);
  for (int i = 0; i < 16; i++){
    if (i >= uCount) break;
    vec2 d = p - uBalls[i].xy;
    float R2 = 4.0 * uBalls[i].z * uBalls[i].z;
    float dd = dot(d, d);
    float q = max(0.0, 1.0 - dd / R2);
    float w3 = q * q * q;
    f += w3;
    ldir += w3 * uLdir[i];
    g += -6.0 * q * q * d / R2;
    float cq = max(0.0, 1.0 - dd / (R2 * uGlowSize));
    spill += cq * cq * cq;
  }

  const float T = 0.5;
  float vign = clamp(length(p * vec2(0.62, 1.0)) * 0.9 * uVign, 0.0, 1.0);
  float lift = smoothstep(mix(-0.15, 1.30, uSpread), -0.55, p.y);
  vec3 col = mix(uBg[0], uBg[1], vign) + mix(uBg[0], vec3(1.0), 0.25) * lift * uLift;
  col += ramp(0.30) * min(spill, 1.0) * 0.085 * uGlowInt;
  col += ramp(0.12) * smoothstep(0.06, T, f) * 0.20 * uRim;

  float s = clamp((f - T) / (1.0 - T), 0.0, 1.0);
  float gl = length(g);
  vec2 gd = g / (gl + 0.35);
  vec2 Ld = length(ldir) > 1e-4 ? normalize(ldir) : vec2(-0.6, -0.8);
  float lit = dot(gd, Ld);
  float fade = 1.0 - smoothstep(0.45, 0.92, s);
  float sd = clamp(pow(s, 0.42) + lit * 0.62 * fade, 0.0, 1.0);
  vec3 inner = ramp(clamp(sd, 0.0, 0.72)) + 0.022;

  vec3 n = normalize(vec3(g * 0.5, 1.0));
  vec3 L = normalize(vec3(0.0, -0.72, 0.70));
  inner += vec3(0.34, 0.42, 0.86) * pow(max(dot(n, L), 0.0), 1.6) * 0.26 * smoothstep(0.95, 0.55, s);
  inner += ramp(0.02) * exp(-abs(f - T) * 26.0) * 0.9 * uRim;

  inner += vec3(1.0, 0.97, 0.94) * pow(max(dot(n, L), 0.0), 6.0) * 0.10 * uShine;
  vec2 id = floor(p * 78.0);
  vec2 fr = fract(p * 78.0);
  float r1 = h21(id), r2 = h21(id + 7.7);
  float tw = 0.45 + 0.55 * sin(uTime * uTwF + r1 * 24.0);
  float spark = smoothstep(0.20, 0.0, length(fr - vec2(r1, r2))) * step(0.80, h21(id + 3.3)) * max(tw, 0.0);
  inner += vec3(1.0, 0.98, 0.95) * spark * smoothstep(0.02, 0.35, s) * 0.85 * uShine;

  float w = max(fwidth(f), uSoft);
  float a = clamp((f - T) / max(w, 1e-5) + 0.5, 0.0, 1.0);
  col = mix(col, inner, a);

  float grain = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
  col += (grain - 0.5) * 0.012;
  fragColor = vec4(col, 1.0);
}`;

  function hex(h: string): [number, number, number] {
    return [parseInt(h.slice(0, 2), 16) / 255, parseInt(h.slice(2, 4), 16) / 255, parseInt(h.slice(4, 6), 16) / 255];
  }

  function initLava(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext("webgl2", { antialias: false });
    if (!gl) return;

    const paletteName = canvas.dataset.palette || "Ember";
    const blobCount = Math.max(3, Math.min(12, parseInt(canvas.dataset.blobCount || "9", 10)));
    const speed = parseFloat(canvas.dataset.speed || "0.55");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const mk = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, mk(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, mk(gl.FRAGMENT_SHADER, FRAG));
    gl.bindAttribLocation(prog, 0, "a");
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    const u = {
      res: gl.getUniformLocation(prog, "uRes"),
      balls: gl.getUniformLocation(prog, "uBalls"),
      count: gl.getUniformLocation(prog, "uCount"),
      rim: gl.getUniformLocation(prog, "uRim"),
      stops: gl.getUniformLocation(prog, "uStops"),
      bg: gl.getUniformLocation(prog, "uBg"),
      ldir: gl.getUniformLocation(prog, "uLdir"),
      glowSize: gl.getUniformLocation(prog, "uGlowSize"),
      glowInt: gl.getUniformLocation(prog, "uGlowInt"),
      soft: gl.getUniformLocation(prog, "uSoft"),
      shine: gl.getUniformLocation(prog, "uShine"),
      time: gl.getUniformLocation(prog, "uTime"),
      lift: gl.getUniformLocation(prog, "uLift"),
      spread: gl.getUniformLocation(prog, "uSpread"),
      vign: gl.getUniformLocation(prog, "uVign"),
      twf: gl.getUniformLocation(prog, "uTwF"),
    };

    const pal = PALETTES[paletteName] || PALETTES.Ember;
    gl.uniform3fv(u.stops, new Float32Array(pal.stops.flatMap(hex)));
    gl.uniform3fv(u.bg, new Float32Array(pal.bg.flatMap(hex)));

    let s = 20260814;
    const rnd = () => (s = (s * 1664525 + 1013904223) % 4294967296) / 4294967296;
    const balls = Array.from({ length: blobCount }, (_, i) => ({
      x: (-0.5 + (i + 0.5) / blobCount + (rnd() - 0.5) * 0.25 / blobCount) * 2.05,
      period: 38 + rnd() * 30,
      phase: (i + 0.5) / blobCount + (rnd() - 0.5) * 0.5 / blobCount,
      sway: 0.015 + rnd() * 0.025,
      px: rnd() * 6.28,
      py: rnd() * 6.28,
      sx: 0.08 + rnd() * 0.14,
      lightAngle: -Math.PI / 2 + (rnd() - 0.5) * 0.18,
      lightDrift: 0,
      r: (i % 4 === 0 ? 0.215 : i % 3 === 0 ? 0.145 : 0.1) + rnd() * 0.04,
    }));

    const data = new Float32Array(48);
    const ldir = new Float32Array(32);

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
    }
    window.addEventListener("resize", resize);
    resize();

    function draw(t: number) {
      const asp = canvas.width / Math.max(canvas.height, 1);
      const wide = Math.max(asp, 1) * 0.62;
      const yB = -0.46,
        yT = 0.42;
      balls.forEach((b, i) => {
        const p = ((t * speed) / b.period + b.phase) % 1;
        let y,
          lat = 0;
        if (p < 0.46) {
          y = yB + (yT - yB) * (p / 0.46);
        } else if (p < 0.54) {
          y = yT + Math.sin((p - 0.46) * 39) * 0.008;
        } else {
          const uu = (p - 0.54) / 0.46;
          y = yT - (yT - yB) * (1 - Math.pow(1 - uu, 1.35));
          lat = (i % 2 ? 1 : -1) * 0.045 * Math.sin(Math.PI * uu);
        }
        const r = b.r * (1 + Math.sin(t * 0.18 * speed + b.py) * 0.04);
        const x = (b.x + lat + Math.sin(t * b.sx * speed * 0.3 + b.px) * b.sway) * wide;
        data[i * 3] = x;
        data[i * 3 + 1] = y;
        data[i * 3 + 2] = r;
        const a = b.lightAngle + t * b.lightDrift * speed;
        ldir[i * 2] = Math.cos(a);
        ldir[i * 2 + 1] = Math.sin(a);
      });
      gl.uniform2f(u.res, canvas.width, canvas.height);
      gl.uniform3fv(u.balls, data);
      gl.uniform2fv(u.ldir, ldir);
      gl.uniform1i(u.count, balls.length);
      gl.uniform1f(u.rim, 1);
      gl.uniform1f(u.glowSize, 6);
      gl.uniform1f(u.glowInt, 1);
      gl.uniform1f(u.soft, 0.02);
      gl.uniform1f(u.shine, 0.8);
      gl.uniform1f(u.time, t);
      gl.uniform1f(u.lift, 0.22);
      gl.uniform1f(u.spread, 0.5);
      gl.uniform1f(u.vign, 1);
      gl.uniform1f(u.twf, 1.8);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    if (reduceMotion) {
      draw(0);
      return;
    }

    const t0 = performance.now();
    let raf = 0;
    const loop = () => {
      draw((performance.now() - t0) / 1000);
      raf = requestAnimationFrame(loop);
    };
    loop();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        window.removeEventListener("resize", resize);
      },
      { once: true },
    );
  }

  const canvas = document.getElementById("lava-bg") as HTMLCanvasElement | null;
  if (canvas) initLava(canvas);
</script>
